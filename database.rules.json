{
  "rules": {
    ".read": false,
    ".write": false,

    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$conn": {
          ".validate": "!newData.isString() || newData.val().length <= 1000",
          "name":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
          "avatar": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000)" },
          "photo":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000)" },
          "device": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
          "state":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20)" },
          "$other": { ".validate": false }
        }
      }
    },

    "lan": {

      "challenges": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
        "$challenge_id": {
          ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === auth.uid && newData.child('status').val() === 'proposed') || (data.exists() && !newData.exists() && data.child('createdBy').val() === auth.uid && data.child('status').val() === 'proposed') || root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          ".validate": "newData.hasChildren(['title', 'status', 'createdBy']) && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 120 && newData.child('zl').isNumber() && newData.child('zl').val() >= 0 && newData.child('xp').isNumber() && newData.child('xp').val() >= 0 && (newData.child('status').val() !== 'proposed' || (newData.child('zl').val() <= 300 && newData.child('xp').val() <= 200))"
        }
      },

      "claims": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
        "$claim_id": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending') || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid && data.child('status').val() === 'pending') || root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          ".validate": "newData.hasChildren(['challengeId', 'uid', 'status', 'ts']) && newData.child('ts').val() <= now && (!newData.child('note').exists() || newData.child('note').val().length <= 500)"
        }
      },

      "suggestions": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
        "$suggestion_id": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid) || root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          ".validate": "newData.hasChildren(['uid', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 1000 && newData.child('ts').val() <= now"
        }
      },
      "xp": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",

        "awards": {
          "$award_id": {
            ".write": "auth != null && !data.exists() && (root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
            ".validate": "newData.hasChildren(['uid', 'delta', 'type', 'ts']) && newData.child('delta').isNumber() && newData.child('delta').val() >= 0 && newData.child('ts').val() <= now"
          }
        }
      },

      "economy": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",

        "catalog": {
          ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          "$item_id": {
            ".validate": "newData.hasChildren(['name', 'price'])",
            "price": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        },

        "ledger": {
          "$entry_id": {
            ".write": "auth != null && !data.exists() && ((newData.child('type').val() === 'purchase' && newData.child('uid').val() === auth.uid) || root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
            ".validate": "newData.hasChildren(['uid', 'delta', 'type', 'ts']) && newData.child('delta').isNumber() && (newData.child('type').val() !== 'purchase' || (newData.child('delta').val() < 0 && newData.child('delta').val() === 0 - root.child('lan/economy/catalog').child(newData.child('itemId').val()).child('price').val()))"
          }
        },

        "ticks": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('lan/settings/isLanActive').val() === true",
            ".validate": "newData.hasChildren(['count', 'lastTick']) && newData.child('lastTick').val() <= now && newData.child('count').val() <= 60 && ((!data.exists() && newData.child('count').val() === 1) || (data.exists() && newData.child('count').val() === data.child('count').val() + 1 && newData.child('lastTick').val() >= data.child('lastTick').val() + 600000))",
            "count": { ".validate": "newData.isNumber()" },
            "lastTick": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "purchases": {
          "$purchase_id": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'granted') || root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
            ".validate": "newData.hasChildren(['itemId', 'uid', 'price', 'status', 'ts']) && (data.exists() || newData.child('price').val() === root.child('lan/economy/catalog').child(newData.child('itemId').val()).child('price').val())"
          }
        }
      },
      "tcg": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",

        "currentSet": {
          ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          ".validate": "newData.isString() && newData.val().length <= 60"
        },

        "sets": {
          ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          "$set_id": {
            ".validate": "newData.hasChildren(['name', 'ts', 'cards'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "cards": {
              "$game_key": {
                ".validate": "newData.hasChildren(['name', 'rarity'])",
                "name":   { ".validate": "newData.isString() && newData.val().length <= 200" },
                "rarity": { ".validate": "newData.isString() && newData.val().length <= 20" },
                "score":  { ".validate": "!newData.exists() || newData.isNumber()" },
                "owners": { ".validate": "!newData.exists() || newData.isNumber()" },
                "appId":  { ".validate": "!newData.exists() || newData.isNumber()" },
                "$other": { ".validate": false }
              }
            }
          }
        },

        "packs": {
          "$pack_id": {
            ".write": "auth != null && newData.exists() && ((!data.exists() && newData.child('status').val() === 'sealed' && newData.child('sealedAt').val() === now && newData.child('setId').val() === root.child('lan/tcg/currentSet').val() && ((newData.child('uid').val() === auth.uid && root.child('lan/economy/purchases').child($pack_id).child('uid').val() === auth.uid && root.child('lan/economy/purchases').child($pack_id).child('status').val() === 'granted' && root.child('lan/economy/catalog').child(root.child('lan/economy/purchases').child($pack_id).child('itemId').val()).child('kind').val() === 'pack') || root.child('lan/roles').child(auth.uid).val() === 'gamemaster')) || (data.exists() && data.child('status').val() === 'sealed' && data.child('uid').val() === auth.uid && newData.child('status').val() === 'opened' && newData.child('openedAt').val() === now && newData.child('uid').val() === data.child('uid').val() && newData.child('setId').val() === data.child('setId').val() && newData.child('sealedAt').val() === data.child('sealedAt').val()))",
            ".validate": "newData.hasChildren(['uid', 'setId', 'status', 'sealedAt'])",
            "uid":      { ".validate": "newData.isString() && newData.val().length <= 60" },
            "setId":    { ".validate": "newData.isString() && newData.val().length <= 60" },
            "status":   { ".validate": "newData.val() === 'sealed' || newData.val() === 'opened'" },
            "sealedAt": { ".validate": "newData.isNumber()" },
            "openedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "origin":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
            "label":    { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
            "$other":   { ".validate": false }
          }
        },

        "trades": {
          "$trade_id": {
            ".write": "auth != null && newData.exists() && ((!data.exists() && newData.child('fromUid').val() === auth.uid && newData.child('toUid').val() !== auth.uid && newData.child('status').val() === 'pending' && newData.child('ts').val() === now) || (data.exists() && data.child('status').val() === 'pending' && newData.child('fromUid').val() === data.child('fromUid').val() && newData.child('toUid').val() === data.child('toUid').val() && newData.child('offer').val() === data.child('offer').val() && newData.child('request').val() === data.child('request').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('resolvedAt').val() === now && ((auth.uid === data.child('toUid').val() && (newData.child('status').val() === 'accepted' || newData.child('status').val() === 'declined')) || (auth.uid === data.child('fromUid').val() && newData.child('status').val() === 'cancelled'))))",
            ".validate": "newData.hasChildren(['fromUid', 'toUid', 'status', 'ts'])",
            "fromUid":  { ".validate": "newData.isString() && newData.val().length <= 60" },
            "toUid":    { ".validate": "newData.isString() && newData.val().length <= 60" },
            "offer":    { ".validate": "newData.isString() && newData.val().length <= 800" },
            "request":  { ".validate": "newData.isString() && newData.val().length <= 800" },
            "status":   { ".validate": "newData.val() === 'pending' || newData.val() === 'accepted' || newData.val() === 'declined' || newData.val() === 'cancelled'" },
            "ts":         { ".validate": "newData.isNumber()" },
            "resolvedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "fromName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
            "toName":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
            "note":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
            "$other":   { ".validate": false }
          }
        }
      },

      "cardArt": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'gamemaster' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
        "$game_key": {
          ".validate": "newData.hasChildren(['data', 'ts'])",
          "data": { ".validate": "newData.isString() && newData.val().length <= 4000000 && newData.val().beginsWith('data:image/')" },
          "ts":   { ".validate": "newData.isNumber()" },
          "by":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)" },
          "name": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
          "$other": { ".validate": false }
        }
      },

      "votes": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
        "$user_id": {
          ".write": "auth != null && auth.uid === $user_id",
          ".validate": "newData.hasChildren()",
          "name": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)" },
          "votes": {
            "p1":      { ".validate": "!newData.exists() || newData.hasChildren()", "$g": { ".validate": "$g.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 200" } },
            "p2":      { ".validate": "!newData.exists() || newData.hasChildren()", "$g": { ".validate": "$g.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 200" } },
            "p3":      { ".validate": "!newData.exists() || newData.hasChildren()", "$g": { ".validate": "$g.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 200" } },
            "p_other": { ".validate": "!newData.exists() || newData.hasChildren()", "$g": { ".validate": "$g.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 200" } },
            "$other":  { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      },

      "settings": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')"
      },

      "roles": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')"
      },

      "history": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')"
      },

      "events": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
        "$event_id": {
          ".write": "auth != null && ((!data.exists() && newData.child('creatorId').val() === auth.uid) || (data.exists() && data.child('creatorId').val() === auth.uid) || root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          "title":        { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
          "description":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 5000)" },
          "game":         { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
          "time":         { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)" },
          "date":         { ".validate": "!newData.exists() || (newData.isString() && (newData.val().length === 0 || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)))" },
          "alcoholRules": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 5000)" },
          "creatorName":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
          "rsvps": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50)"
            }
          },
          "$other": { ".validate": "!newData.hasChildren() && (!newData.isString() || newData.val().length <= 2000)" }
        }
      },

      "cocktails": {
        ".read": "auth != null",
        "masterList": {
          ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'mixologist' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          "$kocktail_id": {
            "name":        { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
            "ingredients": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 5000)" },
            "$other":      { ".validate": "!newData.hasChildren() && (!newData.isString() || newData.val().length <= 2000)" }
          }
        },
        "oneshot": {
          ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          "$kocktail_id": {
            ".write": "auth != null && ((!data.exists() && newData.child('creatorId').val() === auth.uid) || (data.exists() && data.child('creatorId').val() === auth.uid) || root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
            "name":        { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
            "recipe":      { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 5000)" },
            "creatorName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
            "$other":      { ".validate": "!newData.hasChildren() && (!newData.isString() || newData.val().length <= 2000)" }
          }
        },
        "orders": {
          ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'mixologist' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          "$order_id": {
            ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && data.child('userId').val() === auth.uid) || root.child('lan/roles').child(auth.uid).val() === 'admin' || root.child('lan/roles').child(auth.uid).val() === 'mixologist' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
            "cocktailName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
            "userName":     { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
            "$other":       { ".validate": "!newData.hasChildren() && (!newData.isString() || newData.val().length <= 2000)" }
          }
        }
      },

      "notifications": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$notif_id": {
            ".write": "auth != null && $notif_id.beginsWith(auth.uid + '__')",
            ".validate": "newData.hasChild('message') && (data.exists() || newData.hasChild('senderId'))",
            "message":   { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "senderId":  { ".validate": "data.exists() || $notif_id.beginsWith(newData.val() + '__')" },
            "type":      { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20)" },
            "read":      { ".validate": "!newData.exists() || newData.isBoolean()" },
            "timestamp": { ".validate": "!newData.exists() || newData.isNumber()" },
            "$other":    { ".validate": false }
          }
        }
      },

      "users": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "name":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
          "avatar": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 1000)" },
          "lastSeen": { ".validate": "!newData.exists() || newData.isNumber()" },
          "equippedTitleId": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64 && (root.child('lan/xp/awards').child($uid + '__ach__' + newData.val()).exists() || (newData.val() === 'administrator' && (root.child('lan/roles').child($uid).val() === 'admin' || $uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2'))))"
          },
          "featuredAchievement1": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64 && root.child('lan/xp/awards').child($uid + '__ach__' + newData.val()).exists())"
          },
          "featuredAchievement2": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64 && root.child('lan/xp/awards').child($uid + '__ach__' + newData.val()).exists())"
          },
          "featuredAchievement3": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64 && root.child('lan/xp/awards').child($uid + '__ach__' + newData.val()).exists())"
          },
          "$other": { ".validate": false }
        }
      },

      "steamLibraries": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
        "$steam_id": {
          ".write": "auth != null && ((!data.exists() && newData.child('addedBy').val() === auth.uid) || (data.exists() && data.child('addedBy').val() === auth.uid) || root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          "personaName":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
          "addedByName":  { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
          "games": {
            "$g": {
              "name":   { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
              "$other": { ".validate": "!newData.hasChildren() && (!newData.isString() || newData.val().length <= 2000)" }
            }
          },
          "$other": { ".validate": "!newData.hasChildren() && (!newData.isString() || newData.val().length <= 2000)" }
        }
      },

      "installed": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
        "$uid": {
          ".write": "auth != null && ($uid === auth.uid || root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          "$game_key": { ".validate": "!newData.exists() || newData.isBoolean()" }
        }
      },

      "polls": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
        "$poll_id": {
          ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid) || root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          "question":      { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
          "createdByName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
          "options": {
            "$option_id": {
              "label": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" }
            }
          },
          "votes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50)"
            }
          },
          "audience": {
            "$uid": { ".validate": "newData.isBoolean()" }
          },
          "$other": { ".validate": "!newData.hasChildren() && (!newData.isString() || newData.val().length <= 2000)" }
        }
      },

      "foodRuns": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
        "$run_id": {
          ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid) || root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
          "place":         { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
          "createdByName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
          "items": {
            "$item_id": {
              ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && data.child('userId').val() === auth.uid) || root.child('lan/foodRuns').child($run_id).child('createdBy').val() === auth.uid || root.child('lan/roles').child(auth.uid).val() === 'admin' || auth.uid === 'ITe5VPuwewMzO7JnJA5oPWMdfvt2')",
              "label":    { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
              "userName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 300)" },
              "$other":   { ".validate": "!newData.hasChildren() && (!newData.isString() || newData.val().length <= 2000)" }
            }
          },
          "$other": { ".validate": "!newData.hasChildren() && (!newData.isString() || newData.val().length <= 2000)" }
        }
      }
    }
  }
}
